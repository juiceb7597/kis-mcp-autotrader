{
  "name": "주식 리서치 수집",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// 2026년 한국 공휴일 목록 (이미지 참고 반영)\nconst holidays2026 = [\n  \"2026-01-01\", // 신정\n  \"2026-02-16\", \"2026-02-17\", \"2026-02-18\", // 설날 연휴\n  \"2026-03-01\", \"2026-03-02\", // 3.1절 및 대체공휴일\n  \"2026-05-05\", // 어린이날\n  \"2026-05-24\", \"2026-05-25\", // 부처님 오신 날 및 대체공휴일\n  \"2026-06-06\", // 현충일\n  \"2026-08-15\", \"2026-08-17\", // 광복절 및 대체공휴일\n  \"2026-09-24\", \"2026-09-25\", \"2026-09-26\", // 추석 연휴\n  \"2026-10-03\", \"2026-10-05\", // 개천절 및 대체공휴일\n  \"2026-10-09\", // 한글날\n  \"2026-12-25\", // 크리스마스\n];\n\n// 현재 시간 기준 KST(한국 표준시) 계산\nconst now = new Date();\nconst kstDate = new Date(now.getTime() + (9 * 60 * 60 * 1000));\n\nconst year = kstDate.getUTCFullYear();\nconst month = String(kstDate.getUTCMonth() + 1).padStart(2, '0');\nconst day = String(kstDate.getUTCDate()).padStart(2, '0');\nconst dateString = `${year}-${month}-${day}`;\n\nconst hours = kstDate.getUTCHours();\nconst minutes = kstDate.getUTCMinutes();\nconst dayOfWeek = kstDate.getUTCDay(); // 0: 일요일, 6: 토요일\n\n// 1. 주말 체크\nconst isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);\n\n// 2. 공휴일 체크\nconst isHoliday = holidays2026.includes(dateString);\n\n// 3. 업무 시간 체크 (08:30 ~ 18:30)\nconst currentTimeInMinutes = (hours * 60) + minutes;\nconst startMinutes = (8 * 60) + 30;\nconst endMinutes = (18 * 60) + 30;\nconst isBusinessHours = (currentTimeInMinutes >= startMinutes && currentTimeInMinutes <= endMinutes);\n\n// 최종 실행 여부 결정\nconst shouldRun = !isWeekend && !isHoliday && isBusinessHours;\n\nreturn {\n  shouldRun,\n  status: shouldRun ? \"정상 작동\" : \"중단 (주말/휴일/시간외)\",\n  debug: {\n    kstTime: `${hours}:${minutes}`,\n    date: dateString,\n    day: [\"일\", \"월\", \"화\", \"수\", \"목\", \"금\", \"토\"][dayOfWeek]\n  }\n};"
      },
